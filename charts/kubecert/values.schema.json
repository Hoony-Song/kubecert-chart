{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": { "type": "string" },
        "imagePullSecrets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "affinity": { "type": "object" },
        "tolerations": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "images": {
      "type": "object",
      "properties": {
        "api": { "$ref": "#/definitions/image" },
        "worker": { "$ref": "#/definitions/image" },
        "terminalGateway": { "$ref": "#/definitions/image" },
        "examWeb": { "$ref": "#/definitions/image" },
        "adminWeb": { "$ref": "#/definitions/image" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "corsOrigins": {
          "type": "array",
          "items": { "type": "string" }
        },
        "publicApiUrl": { "type": "string" },
        "allowInsecurePublicApiUrl": { "type": "boolean" },
        "artifactBaseUrl": { "type": "string" },
        "runtimeNodeInstallerUrl": { "type": "string" },
        "runtimeNodeManifestUrl": { "type": "string" },
        "frontend": {
          "type": "object",
          "properties": {
            "examApiBaseUrl": { "type": "string" },
            "adminApiBaseUrl": { "type": "string" },
            "terminalHost": { "type": "string" },
            "terminalWsBaseUrl": { "type": "string" }
          }
        },
        "backend": {
          "type": "object",
          "properties": {
            "examDurationMinutes": { "type": "integer", "minimum": 1 },
            "unstartedSessionTtlHours": { "type": "integer", "minimum": 1 },
            "expirySweepIntervalSeconds": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "r2": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "publicBaseUrl": { "type": "string" },
        "endpointUrl": { "type": "string" },
        "bucket": { "type": "string" },
        "region": { "type": "string" },
        "forcePathStyle": { "type": "boolean" },
        "auth": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "existingSecret": { "type": "string" },
            "accessKeyIdKey": { "type": "string" },
            "secretAccessKeyKey": { "type": "string" }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["bundled", "external"]
        }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["bundled", "external"]
        }
      }
    },
    "keda": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["bundled", "external"]
        }
      }
    },
    "questionBank": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": {
          "type": "string",
          "enum": ["artifact", "existingClaim"]
        },
        "version": { "type": "string" },
        "artifactUrl": { "type": "string" },
        "artifactSha256": { "type": "string" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "baseHost": { "type": "string" },
        "subdomains": {
          "type": "object",
          "properties": {
            "exam": { "type": "string" },
            "admin": { "type": "string" },
            "api": { "type": "string" },
            "terminal": { "type": "string" }
          }
        },
        "sameOriginApi": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "hosts": {
          "type": "object",
          "properties": {
            "exam": { "type": "string" },
            "admin": { "type": "string" },
            "api": { "type": "string" },
            "terminal": { "type": "string" }
          }
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "type": "string" }
      }
    }
  }
}
