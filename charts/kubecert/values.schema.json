{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": { "type": "string" },
        "imagePullSecrets": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "images": {
      "type": "object",
      "properties": {
        "api": { "$ref": "#/definitions/image" },
        "worker": { "$ref": "#/definitions/image" },
        "terminalGateway": { "$ref": "#/definitions/image" },
        "examWeb": { "$ref": "#/definitions/image" },
        "adminWeb": { "$ref": "#/definitions/image" }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "corsOrigins": {
          "type": "array",
          "items": { "type": "string" }
        },
        "publicApiUrl": { "type": "string" },
        "artifactBaseUrl": { "type": "string" },
        "runtimeNodeInstallerUrl": { "type": "string" },
        "runtimeNodeManifestUrl": { "type": "string" },
        "frontend": {
          "type": "object",
          "properties": {
            "examApiBaseUrl": { "type": "string" },
            "adminApiBaseUrl": { "type": "string" }
          }
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["bundled", "external"]
        }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["bundled", "external"]
        }
      }
    },
    "keda": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["bundled", "external", "disabled"]
        }
      }
    },
    "questionBank": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": {
          "type": "string",
          "enum": ["artifact", "existingClaim"]
        },
        "artifactUrl": { "type": "string" },
        "artifactSha256": { "type": "string" }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "hosts": {
          "type": "object",
          "properties": {
            "exam": { "type": "string" },
            "admin": { "type": "string" },
            "api": { "type": "string" }
          }
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": { "type": "string" }
          }
        }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "type": "string" }
      }
    }
  }
}
